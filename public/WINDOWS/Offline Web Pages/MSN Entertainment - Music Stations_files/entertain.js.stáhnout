function ParseRatingsDom()
{
	if (ratingsDom == null || ratingsDom.readyState != 4 || ratingsDom.documentElement == null)
	{
		// failed to load document
		PopulateRCs();
		return;
	}
	var nodeUser;
	if (ratingsDom.selectSingleNode('//web.archive.org/web/20031016153108/http://user')) {
		nodeUser = ratingsDom.selectSingleNode('//web.archive.org/web/20031016153108/http://user').attributes;
	}
	var ratings = ratingsDom.selectNodes('//web.archive.org/web/20031016153108/http://ratings/RATING');

	if (nodeUser && nodeUser.getNamedItem('puid')) {
		puId = nodeUser.getNamedItem("puid").text;
	}
	for (var i=0;i<ratings.length;i++) {
		if (null==ratings.item(i) || !ratings.item(i).hasChildNodes()) { continue; }
		if ('RATING'==ratings.item(i).nodeName) {
			var rNode = ratings.item(i);
			var riT = rNode.selectSingleNode('T').text;
			var riId = rNode.selectSingleNode('ID').text;
			rHash(riT,riId);
	
			rHash(riT,riId).average = rNode.selectSingleNode('AVG').text.substring(0,3);
			rHash(riT,riId).total = rNode.selectSingleNode('TOT').text;
			rHash(riT,riId).usrLvlDesc = rNode.selectSingleNode('ULD').text;
			rHash(riT,riId).usrLvlIcon = rNode.selectSingleNode('ULI').text;
			if (puId && rNode.selectSingleNode('USR')) {
				rHash(riT,riId).user = rNode.selectSingleNode('USR').text;
			} else { rHash(riT,riId).user = -1; }
		}
	}
	ratingsDom = null;
	PopulateRCs();
}
